<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store build: sandboxed. Covers Chat (v0.1) and, with in-process
         implementations, Code/Cowork read/search/diff/patch. Raw run_shell is
         not model-exposed in any production profile; subprocess-backed tools
         are unavailable here. See ARCHITECTURE.md §9.1. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Call the model API. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Receive the OAuth redirect on an ephemeral loopback-only listener.
         MCPOAuthLoopbackListener binds 127.0.0.1/::1 and rejects non-loopback
         traffic; App Sandbox classifies the accepted redirect as inbound. -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- User-selected workspace folders, persisted via security-scoped bookmarks. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
</dict>
</plist>
