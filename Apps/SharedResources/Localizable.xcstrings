    "Current launch is forced to %@. This picker is saved immediately for the next launch without an override, so a rescued session can remain in safe mode." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Current launch is forced to %@. This picker is saved immediately for the next launch without an override, so a rescued session can remain in safe mode."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前启动已强制使用 %@。此选择会立即保存，并在下次没有启动覆盖时生效，因此恢复后的会话仍可保持安全模式。"
          }
        }
      }
