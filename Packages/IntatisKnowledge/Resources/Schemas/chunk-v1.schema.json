{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.intatis.local/knowledge/chunk-v1.schema.json",
  "title": "Intatis grounded retrieval chunk v1",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "conceptLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "end"
      ],
      "properties": {
        "kind": {
          "const": "utf8-byte-range"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "at"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "supportingConcept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_id",
        "concept_revision",
        "concept_locator"
      ],
      "properties": {
        "concept_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "concept_revision": {
          "$ref": "#/$defs/digest"
        },
        "concept_locator": {
          "$ref": "#/$defs/conceptLocator"
        }
      }
    },
    "sourceLocator": {
      "$ref": "source-locator-v1.schema.json"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "chunk_id",
    "evidence_class",
    "text",
    "text_sha256",
    "source_ids",
    "producer"
  ],
  "properties": {
    "schema": {
      "const": "intatis-chunk/1"
    },
    "chunk_id": {
      "type": "string",
      "pattern": "^chk_[A-Za-z0-9._-]{1,128}$"
    },
    "concept_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "concept_revision": {
      "$ref": "#/$defs/digest"
    },
    "evidence_class": {
      "enum": [
        "exact_concept_slice",
        "generated_derivative"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "text_sha256": {
      "$ref": "#/$defs/digest"
    },
    "concept_locator": {
      "$ref": "#/$defs/conceptLocator"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "source_locators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/sourceLocator"
      }
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "supporting_concepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/supportingConcept"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_class": {
            "const": "exact_concept_slice"
          }
        }
      },
      "then": {
        "required": [
          "concept_id",
          "concept_revision",
          "concept_locator"
        ],
        "not": {
          "required": [
            "supporting_concepts"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_class": {
            "const": "generated_derivative"
          }
        }
      },
      "then": {
        "required": [
          "supporting_concepts"
        ],
        "not": {
          "required": [
            "concept_locator"
          ]
        }
      }
    }
  ]
}
